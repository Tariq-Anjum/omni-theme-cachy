{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "omni theme list*": "allow",
      "omni theme current*": "allow",
      "omni theme validate*": "allow",
      "omni theme preview*": "allow",
      "omni wallpaper list*": "allow",
      "omni wallpaper current*": "allow",
      "omni status*": "allow",
      "omni doctor*": "allow",
      "omni version*": "allow",
      "omni commands*": "allow",
      ".venv/bin/omni theme list*": "allow",
      ".venv/bin/omni theme current*": "allow",
      ".venv/bin/omni theme validate*": "allow",
      ".venv/bin/omni theme preview*": "allow",
      ".venv/bin/omni status*": "allow",
      ".venv/bin/omni doctor*": "allow",
      ".venv/bin/omni version*": "allow",
      ".venv/bin/omni commands*": "allow",
      "pytest*": "allow",
      "python -m compileall*": "allow",
      "python scripts/audit_*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "ask",
      "git tag*": "ask",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "npm install*": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    },
    "edit": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask"
  }
}
